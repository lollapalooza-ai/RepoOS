import torch
import torch.nn as nn
import torch.sparse

class GeneratedModule(torch.nn.Module):
    """
    This module implements a single iteration of the PageRank algorithm.
    It follows the formula:
    x_next = alpha * (A_norm^T * x_k) + [alpha * dot(d, x_k) + (1 - alpha)] * p
    where:
    - x_k: Current PageRank vector (pagerank_vec)
    - alpha: Damping factor (alpha)
    - A_norm^T: Transpose of the column-normalized adjacency matrix (adj_csr)
    - d: Indicator vector for dangling nodes (dangling_nodes_vec)
    - p: Personalization vector (personalization_vec)
    """
    def __init__(self):
        super().__init__()

    def forward(
        self,
        adj_csr: torch.Tensor,
        pagerank_vec: torch.Tensor,
        personalization_vec: torch.Tensor,
        dangling_nodes_vec: torch.Tensor,
        alpha: float,
        out: torch.Tensor,
    ):
        """
        Performs one step of the PageRank power iteration.

        Args:
            adj_csr (torch.Tensor): The sparse adjacency matrix of the graph,
                                    pre-normalized and transposed (N, N).
            pagerank_vec (torch.Tensor): The current PageRank vector (N, 1).
            personalization_vec (torch.Tensor): The personalization vector (N, 1).
            dangling_nodes_vec (torch.Tensor): A 1D vector indicating dangling
                                               nodes (N,).
            alpha (float): The damping factor.
            out (torch.Tensor): The pre-allocated output tensor for the result (N, 1).

        Returns:
            torch.Tensor: The mutated output tensor containing the next PageRank vector.
        """
        # Calculate the total rank contribution from dangling nodes.
        # torch.dot requires 1D tensors, so we squeeze the pagerank_vec.
        dangling_rank_sum = torch.dot(dangling_nodes_vec, pagerank_vec.squeeze(-1))

        # Calculate the teleportation factor which combines the dangling rank
        # and the base teleport probability.
        teleport_factor = (alpha * dangling_rank_sum) + (1.0 - alpha)

        # Calculate the full teleportation vector and write it to the output buffer.
        # This initializes `out` with the second part of the PageRank formula.
        # out = personalization_vec * teleport_factor
        torch.mul(personalization_vec, teleport_factor, out=out)

        # Perform the sparse matrix-vector multiplication to propagate ranks
        # through the graph's edges.
        propagated_ranks = torch.sparse.mm(adj_csr, pagerank_vec)

        # Add the scaled propagated ranks to the teleportation vector already in `out`.
        # This is equivalent to: out = out + alpha * propagated_ranks
        torch.add(out, propagated_ranks, alpha=alpha, out=out)

        return out

